{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xl8saif.github.io/site/ai-skills/second-brain/schemas/memory.schema.json",
  "title": "Saif Second Brain Memory",
  "type": "object",
  "required": ["id", "type", "content", "status", "confidence", "source", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"enum": ["semantic", "episodic", "procedural", "preference", "terminology", "correction", "research", "relationship"]},
    "content": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "domain": {"type": "string"},
    "project": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["verified", "established", "tentative", "superseded"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"$ref": "source.schema.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "related_ids": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
