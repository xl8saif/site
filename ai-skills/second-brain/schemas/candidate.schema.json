{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://xl8saif.github.io/site/ai-skills/second-brain/schemas/candidate.schema.json",
  "title":"Saif Second Brain Candidate",
  "type":"object",
  "required":["id","kind","content","source","confidence","state"],
  "properties":{
    "id":{"type":"string","minLength":1},
    "kind":{"enum":["memory","decision","terminology","correction","research","preference","workflow"]},
    "content":{"type":"string","minLength":1},
    "summary":{"type":"string"},
    "source":{"$ref":"source.schema.json"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "state":{"enum":["candidate","accepted","rejected","merged"]},
    "related_ids":{"type":"array","items":{"type":"string"}},
    "duplicate_of":{"type":["string","null"]},
    "conflicts_with":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":false
}