{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xl8saif.github.io/site/ai-skills/second-brain/schemas/decision.schema.json",
  "title": "Saif Second Brain Decision",
  "type": "object",
  "required": ["id", "question", "decision", "status", "confidence", "source", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "superseded", "reopened", "tentative"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source": {"$ref": "source.schema.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "superseded_by": {"type": ["string", "null"]},
    "review_after": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
