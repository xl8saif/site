    ]
  },
  "security": {
    "scanner": "NVIDIA SkillSpector",
    "version": "2.11.2",
    "mode": "static-only",
    "gate": "ai-skills/core/scripts/skill_security_gate.py",
    "policy": "ai-skills/core/SKILL_SECURITY.md",
    "fail_on": [
      "incomplete-analysis",
      "risk-score-over-50"
    ]
  },
  "version": "1.24.0",
  "factory": {
    "template": "templates/skill",
    "generator": "scripts/create_skill.py",
    "status": "stable"
  },
  "evaluation": {
    "schema": "core/evaluation.schema.json",
    "engine": "core/scripts/evaluate.py"
  },
  "runner": {
    "command": "python ai-skills/run.py all",
    "path": "ai-skills/run.py",
    "status": "stable",
    "commands": [
      "list",
      "audit",
      "validate",
      "evaluate",
      "retrieve",
      "promote-check",
      "check",
      "all",
      "review"
    ]
  },
  "paperclip": {
    "status": "integrated",
    "source_of_truth": "ai-skills",
    "project_discovery_root": ".agents/skills",
    "sync_script": "scripts/sync_paperclip_skills.py",
    "manifest": "paperclip.json"
  },
  "router": {
    "path": "scripts/route_task.py",
    "profiles": "paperclip-agent-profiles.json",
    "test": "scripts/test_router.py",
    "status": "stable",
    "plan": "scripts/plan_task.py",
    "plan_test": "scripts/test_plan.py",
    "execution": "scripts/execute_task.py",
    "execution_test": "scripts/test_execute.py",
    "review_gate": "scripts/review_gate.py",
    "review_gate_test": "scripts/test_review_gate.py",
    "traceability": "scripts/review_gate.py",
    "traceability_schema": "core/evidence.schema.json"
  },
  "second_brain": {
    "path": "SECOND_BRAIN.md",
    "status": "experimental",
    "storage": "private-by-default",
    "mcp_target": "brain_search,brain_get,brain_remember,brain_update,brain_forget,brain_decisions,brain_conflicts,brain_sources"
  }
